rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 60;

      allow delete: if false;

      match /private/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /territories/{territoryId} {
      function shaped(d) {
        return d.wkt is string && d.wkt.size() <= 200000
            && d.areaM2 is number && d.areaM2 >= 0
            && d.rev is int;
      }

      function groundOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['wkt', 'areaM2', 'rev', 'updatedAt']);
      }

      allow read: if signedIn();

      allow create: if isOwner(request.resource.data.ownerId)
                    && shaped(request.resource.data)
                    && request.resource.data.areaM2 > 0
                    && request.resource.data.ownerName is string
                    && request.resource.data.ownerName.size() <= 60
                    && request.resource.data.colorHex is string
                    && request.resource.data.colorHex.size() == 7
                    && request.resource.data.cells is list
                    && request.resource.data.cells.size() <= 40;

      allow update: if signedIn()
                    && shaped(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.rev > resource.data.rev
                    && (resource.data.areaM2 > 0 || request.resource.data.areaM2 == 0)
                    && (isOwner(resource.data.ownerId)
                        || (groundOnly()
                            && request.resource.data.areaM2 <= resource.data.areaM2));

      allow delete: if false;
    }

    match /runs/{runId} {
      allow read: if isOwner(resource.data.ownerId)
                  || (signedIn() && resource.data.isPublic == true);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);
    }
  }
}
